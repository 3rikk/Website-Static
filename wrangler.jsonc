{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website-static",
  "compatibility_date": "2026-05-17",
  "observability": {
    "enabled": true
  },
  "assets": {
		"directory": ".",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	}
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
